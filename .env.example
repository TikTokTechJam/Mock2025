# Local Docker Compose ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1

# Production web build and local plate-only model bootstrap settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PRIVASTREAM_MODEL_ID=plate-detector
PRIVASTREAM_FACE_MODEL_ID=

# GPU Compose override; the CPU topology ignores this value
NVIDIA_VISIBLE_DEVICES=0

# Local PostgreSQL initialization values
POSTGRES_DB=privastream
POSTGRES_USER=privastream
POSTGRES_PASSWORD=change-me-local-only
